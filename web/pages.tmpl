{{define "base-head"}}<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{.PageTitle}}</title>
  <script>(function(){try{var accent=localStorage.getItem("datashelf.accent.v1"),theme=localStorage.getItem("datashelf.theme.v1");if(["azure","forest","terracotta"].indexOf(accent)>=0){document.documentElement.dataset.accent=accent}if(["light","dark"].indexOf(theme)>=0){document.documentElement.dataset.theme=theme}}catch(_){}}());</script>
  <style>
    :root { --bg:#f4f7fb; --surface:rgba(255,255,255,.96); --subtle:#f5f9fe; --ink:#162234; --text:#4c5c71; --muted:#64748b; --border:#dce4ef; --primary:#1268c4; --primary-hover:#075aaf; --focus:#1f73df; --active-bg:#eaf3ff; --active-ink:#0756ae; --danger:#a33d22; --warning:#8b5d00; --shadow:0 8px 24px rgba(24,44,74,.05); color:#162234; background:#f4f7fb; font-family:Inter,"PingFang SC","Microsoft YaHei",system-ui,sans-serif; line-height:1.5; }
    :root[data-accent="forest"] { --primary:#286a4b; --primary-hover:#195438; --focus:#157347; --active-bg:#e6f4ea; --active-ink:#195438; }
    :root[data-accent="terracotta"] { --primary:#b84a27; --primary-hover:#943616; --focus:#b74620; --active-bg:#ffebe4; --active-ink:#943616; }
    :root[data-theme="dark"] { --bg:#111a26; --surface:#172231; --subtle:#1d2a3a; --ink:#edf4fb; --text:#c4d0dd; --muted:#9aabba; --border:#304256; --primary:#74b7ff; --primary-hover:#9acaff; --focus:#9acaff; --active-bg:#153253; --active-ink:#c1e0ff; --danger:#ffae9b; --warning:#ffd185; --shadow:none; color:#edf4fb; background:#111a26; }
    :root[data-theme="dark"][data-accent="forest"] { --primary:#7bd6a4; --primary-hover:#a4eac3; --focus:#a4eac3; --active-bg:#153c2a; --active-ink:#c1f3d5; }
    :root[data-theme="dark"][data-accent="terracotta"] { --primary:#ffb092; --primary-hover:#ffcfbb; --focus:#ffcfbb; --active-bg:#512619; --active-ink:#ffdbcc; }
    @media (prefers-color-scheme:dark) { :root:not([data-theme]) { --bg:#111a26; --surface:#172231; --subtle:#1d2a3a; --ink:#edf4fb; --text:#c4d0dd; --muted:#9aabba; --border:#304256; --primary:#74b7ff; --primary-hover:#9acaff; --focus:#9acaff; --active-bg:#153253; --active-ink:#c1e0ff; --danger:#ffae9b; --warning:#ffd185; --shadow:none; color:#edf4fb; background:#111a26; } :root:not([data-theme])[data-accent="forest"] { --primary:#7bd6a4; --primary-hover:#a4eac3; --focus:#a4eac3; --active-bg:#153c2a; --active-ink:#c1f3d5; } :root:not([data-theme])[data-accent="terracotta"] { --primary:#ffb092; --primary-hover:#ffcfbb; --focus:#ffcfbb; --active-bg:#512619; --active-ink:#ffdbcc; } }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--bg); color:var(--ink); }
    a { color:inherit; } a:focus-visible,button:focus-visible,input:focus-visible { outline:3px solid var(--focus); outline-offset:3px; }
    .topbar { height:56px; border-bottom:1px solid var(--border); background:var(--surface); } .topbar-inner { display:flex; width:min(1120px,100%); height:100%; margin:0 auto; padding:0 32px; align-items:center; justify-content:space-between; gap:16px; } .brand { display:flex; align-items:center; gap:10px; color:var(--ink); font-weight:720; text-decoration:none; } .brand-mark { display:grid; width:26px; height:26px; place-items:center; border:2px solid var(--primary); border-radius:5px; color:var(--primary); font-size:.75rem; }
    main { width:min(1120px,100%); margin:0 auto; padding:24px 32px 64px; } h1 { margin:0; font-size:clamp(1.625rem,4vw,2rem); line-height:1.25; letter-spacing:-.02em; } h2 { margin:0; font-size:1.125rem; } p { margin:0; }
    .site-header,.directory-heading,.card-top,.app-footer,.modal-head,.modal-foot { display:flex; align-items:center; justify-content:space-between; gap:12px; } .site-header { align-items:end; margin:0 0 24px; } .site-header > div { min-width:0; } .directory-heading { align-items:end; margin:16px 0 24px; }
    .eyebrow,.meta,.empty-copy,.form-help,.preview-help { color:var(--muted); } .eyebrow { margin-bottom:6px; font-size:.875rem; font-weight:650; letter-spacing:.03em; }
    .toolbar,.crumbs,.appearance,.modal-actions,.modal-head-actions,.zoom-controls { display:flex; flex-wrap:wrap; align-items:center; gap:8px; } .toolbar { margin:0; } .appearance { position:relative; flex:0 0 auto; }
    .sort-link,.back-link,.entry-action,.modal-control { min-height:36px; border:1px solid var(--border); border-radius:7px; padding:7px 10px; background:var(--surface); color:var(--text); text-decoration:none; font:inherit; font-size:.8125rem; cursor:pointer; } .appearance-toggle { display:grid; width:40px; height:40px; place-items:center; padding:0; border:1px solid transparent; border-radius:7px; background:transparent; color:var(--text); cursor:pointer; } .appearance-toggle:hover { background:var(--subtle); }
    .sort-link[aria-current="true"],.appearance [role="menuitemradio"][aria-checked="true"] { border-color:var(--primary); background:var(--active-bg); color:var(--active-ink); font-weight:700; }
    .appearance-menu { position:absolute; z-index:2; top:48px; right:0; width:min(240px,calc(100vw - 32px)); padding:6px; border:1px solid var(--border); border-radius:10px; background:var(--surface); box-shadow:var(--shadow); } .appearance-menu[hidden] { display:none; } .appearance-menu [role="menuitemradio"] { display:flex; width:100%; min-height:40px; align-items:center; gap:9px; border:0; border-radius:6px; padding:0 9px; background:transparent; color:var(--text); font:inherit; text-align:left; cursor:pointer; } .appearance-menu [role="menuitemradio"]::before { width:16px; color:var(--primary); content:"✓"; font-weight:800; } .appearance-menu [role="menuitemradio"][aria-checked="false"]::before { visibility:hidden; } .appearance-menu-label { display:block; padding:7px 9px 5px; color:var(--muted); font-size:.75rem; font-weight:700; }
    .app-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr)); gap:12px; } .card,.panel,.directory-list { background:var(--surface); border:1px solid var(--border); border-radius:10px; box-shadow:var(--shadow); }
    .app-card { display:grid; gap:14px; min-height:148px; padding:18px; color:inherit; text-decoration:none; transition:border-color .12s ease,box-shadow .12s ease; } .app-card:hover { border-color:var(--primary); box-shadow:0 5px 14px color-mix(in srgb,var(--primary) 10%,transparent); }
    .app-name,.entry-name { min-width:0; overflow-wrap:anywhere; font-weight:720; } .description { color:var(--text); overflow-wrap:anywhere; }
    .status { display:inline-flex; flex:0 0 auto; align-items:center; gap:5px; border-radius:999px; padding:4px 8px; background:var(--subtle); color:var(--text); font-size:.75rem; font-weight:700; white-space:nowrap; } .status.locked { background:#fff1ed; color:var(--danger); } .status.protected { background:#fff8e6; color:var(--warning); }
    .guide { margin-top:18px; padding:16px; border-radius:12px; background:var(--subtle); text-align:left; } .guide ol { margin:8px 0 0; padding-left:22px; }
    .crumbs { display:flex; gap:8px; margin:0; color:var(--muted); font-size:.8125rem; } .crumbs a { border-radius:4px; color:var(--text); } .crumb-separator { color:var(--muted); } .directory-list { overflow:hidden; } .directory-list ul { padding:0; margin:0; list-style:none; } .entry + .entry { border-top:1px solid var(--border); } .entry { display:grid; grid-template-columns:minmax(0,1fr) 78px 92px 130px 68px; gap:16px; align-items:center; min-height:56px; padding:0 16px; } .entry:hover { background:var(--subtle); }
    .entry-link { min-width:0; color:inherit; overflow-wrap:anywhere; text-decoration:none; font-weight:650; } .entry-type,.entry-size,.entry-modified { color:var(--muted); font-size:.8125rem; } .entry-type { font-weight:650; } .entry-action { width:max-content; min-height:34px; justify-self:end; border-color:transparent; color:var(--primary); font-weight:700; } .entry-action:hover { border-color:var(--border); } .entry-action[hidden] { display:none; }
    .empty { padding:40px 24px; text-align:center; } .empty-icon { display:grid; place-items:center; width:44px; height:44px; margin:0 auto 12px; border-radius:50%; background:var(--active-bg); color:var(--primary); font-size:1.25rem; }
    .panel { width:min(520px,100%); margin:clamp(24px,8vh,88px) auto 0; padding:clamp(24px,5vw,36px); } .panel > * + * { margin-top:16px; }
    .notice { display:flex; gap:10px; padding:12px 14px; border:1px solid #ffd2c8; border-radius:10px; background:#fff5f2; color:var(--danger); } label { display:block; color:var(--ink); font-size:.925rem; font-weight:700; }
    input,button[type="submit"] { width:100%; min-height:46px; margin-top:7px; border-radius:9px; font:inherit; } input { border:1px solid var(--border); padding:10px 12px; background:var(--surface); color:var(--ink); } button[type="submit"] { border:1px solid var(--primary); padding:10px 16px; background:var(--primary); color:#fff; font-weight:720; cursor:pointer; } button[type="submit"]:hover { background:var(--primary-hover); }
    .preview-dialog { width:min(880px,calc(100vw - 48px)); max-height:90vh; padding:0; border:1px solid var(--border); border-radius:14px; background:var(--surface); color:var(--ink); box-shadow:0 24px 64px rgba(0,0,0,.4); } .preview-dialog::backdrop { background:rgba(9,18,30,.68); } .preview-dialog[open] { display:block; } .modal-head { align-items:start; padding:14px 16px; border-bottom:1px solid var(--border); } .modal-head-actions { flex:0 0 auto; justify-content:flex-end; } .modal-share-status { max-width:230px; overflow:hidden; text-overflow:ellipsis; } .modal-close { width:40px; min-height:40px; padding:0; border:0; font-size:1.6rem; line-height:1; } .preview-area { min-height:340px; max-height:calc(90vh - 134px); overflow:auto; padding:24px; background:var(--subtle); } .image-canvas { display:grid; min-height:calc(90vh - 210px); place-items:center; overflow:hidden; touch-action:pan-y; } .image-canvas.is-zoomed { cursor:grab; touch-action:none; } .image-canvas.is-panning { cursor:grabbing; } .preview-image { display:block; max-width:100%; max-height:calc(90vh - 210px); object-fit:contain; transform-origin:center; will-change:transform; } .preview-document { display:block; width:100%; min-height:440px; border:0; background:#fff; } .preview-text { width:min(100%,760px); margin:0 auto; padding:16px; overflow:auto; background:var(--surface); color:var(--ink); font:14px/1.65 ui-monospace,SFMono-Regular,Consolas,monospace; white-space:pre-wrap; overflow-wrap:anywhere; } .modal-foot { padding:12px 16px; border-top:1px solid var(--border); } .modal-foot-left,.preview-nav { display:flex; flex-wrap:wrap; align-items:center; gap:8px; } .modal-control:disabled { opacity:.5; cursor:not-allowed; } .zoom-value { min-width:3.5rem; color:var(--muted); font-variant-numeric:tabular-nums; text-align:center; }
    .page-footer { display:flex; flex-wrap:wrap; gap:8px; margin-top:32px; padding-top:18px; border-top:1px solid var(--border); color:var(--muted); font-size:.8125rem; } .page-footer a { color:var(--text); }
    .visually-hidden { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
    @media (max-width:680px) { .topbar-inner,main { padding-left:16px; padding-right:16px; } .topbar-inner { gap:8px; } main { padding-top:24px; padding-bottom:48px; } .site-header,.directory-heading { display:block; } .site-header .toolbar { margin-top:16px; } .appearance-menu { width:min(288px,calc(100vw - 32px)); } .entry { grid-template-columns:minmax(0,1fr) auto; gap:7px 10px; min-height:unset; padding:12px 14px; } .entry-link { grid-column:1/-1; } .entry-type { grid-column:1; } .entry-size { display:none; } .entry-modified { grid-column:1; grid-row:2; } .entry-action { grid-column:2; grid-row:2; min-height:32px; padding:0 9px; } .modal-foot { align-items:start; flex-direction:column-reverse; } .modal-actions { width:100%; } .modal-actions .modal-control { flex:1; } .preview-document { min-height:360px; } .image-canvas { min-height:260px; } .page-footer { margin-top:24px; } }
    @media (prefers-reduced-motion:reduce) { *,*::before,*::after { scroll-behavior:auto !important; transition-duration:.01ms !important; animation-duration:.01ms !important; } }
  </style>
</head>
<body>{{end}}

{{define "appearance-controls"}}<section class="appearance" aria-label="显示偏好"><button class="appearance-toggle" id="appearance-toggle" type="button" aria-label="显示偏好" aria-haspopup="menu" aria-expanded="false" aria-controls="appearance-menu"><svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"/></svg></button><div class="appearance-menu" id="appearance-menu" role="menu" aria-label="主题与明暗偏好" hidden><span class="appearance-menu-label">色系</span><button type="button" role="menuitemradio" data-accent="azure" aria-checked="true">湛蓝</button><button type="button" role="menuitemradio" data-accent="forest" aria-checked="false">松绿</button><button type="button" role="menuitemradio" data-accent="terracotta" aria-checked="false">陶土</button><span class="appearance-menu-label">明暗偏好</span><button type="button" role="menuitemradio" data-theme="system" aria-checked="true">跟随系统</button><button type="button" role="menuitemradio" data-theme="light" aria-checked="false">浅色</button><button type="button" role="menuitemradio" data-theme="dark" aria-checked="false">深色</button></div></section>{{end}}

{{define "topbar"}}<header class="topbar"><div class="topbar-inner"><a class="brand" href="/"><span class="brand-mark" aria-hidden="true">▦</span><span>资料架</span></a>{{template "appearance-controls" .}}</div></header>{{end}}

{{define "page-footer"}}<footer class="page-footer"><span>© <span data-current-year></span> DataShelf</span><a href="https://github.com/woodcoal/data-shelf" target="_blank" rel="noopener noreferrer">DataShelf 项目</a></footer>{{end}}

{{define "home"}}{{template "base-head" .}}{{template "topbar" .}}<main id="content">
<header class="site-header"><div><p class="eyebrow">本地只读资料架</p><h1>{{.Title}}</h1>{{if .Description}}<p class="description">{{.Description}}</p>{{else}}<p class="description">浏览资料目录；需要密码的目录会在进入前进行验证。</p>{{end}}</div><nav class="toolbar" aria-label="排序方式"><a class="sort-link" href="/?sort=modified" aria-current="{{if not .SortByName}}true{{else}}false{{end}}">最近修改</a><a class="sort-link" href="/?sort=name" aria-current="{{if .SortByName}}true{{else}}false{{end}}">按名称</a></nav></header>
<section class="app-grid" aria-label="应用列表">{{range .Apps}}<a class="card app-card" href="{{.URL}}"><span class="card-top"><span class="app-name">{{.Name}}</span><span class="status {{if .Locked}}locked{{else if .Protected}}protected{{end}}">{{if .Locked}}⚠ 管理员配置待修复{{else if .Protected}}🔒 需要密码{{else}}● 公开{{end}}</span></span>{{if .Description}}<p class="description">{{.Description}}</p>{{else}}<p class="description">暂无说明</p>{{end}}<span class="app-footer"><span class="meta">目录</span><time class="meta" datetime="{{.ModTime.Format "2006-01-02T15:04:05Z07:00"}}">{{.ModTime.Format "2006-01-02 15:04"}}</time></span></a>{{else}}<div class="card empty"><div class="empty-icon" aria-hidden="true">⌁</div><h2>尚无可用应用</h2><p class="empty-copy">在数据目录中新建一个普通目录后，它会显示在这里。</p><div class="guide"><strong>首次管理员引导</strong><ol><li>确认 DataShelf 的数据根目录。</li><li>在其中创建一个资料目录，例如“设计资料”。</li><li>重新访问此页；需要保护时再在目录中放置私有配置。</li></ol></div></div>{{end}}</section>
{{template "page-footer" .}}{{template "page-script" .}}</main></body></html>{{end}}

{{define "login"}}{{template "base-head" .}}{{template "topbar" .}}<main id="content"><section class="panel" aria-labelledby="login-title"><p class="eyebrow">受保护的资料</p><h1 id="login-title">{{.Name}}</h1><p class="description">请输入密码以继续访问。验证成功后会返回你刚才请求的页面。</p>{{if .Message}}<div class="notice" role="alert" aria-live="assertive"><span aria-hidden="true">!</span><span>{{.Message}}</span></div>{{end}}{{if not .Locked}}<form method="post" action="/_auth/{{pathEscape .Slug}}"><input type="hidden" name="return" value="{{.Return}}"><label for="password">密码</label><input id="password" name="password" type="password" autocomplete="current-password" required autofocus aria-describedby="password-help"><p class="form-help" id="password-help">按 Enter 键即可提交。</p><button type="submit">进入资料</button></form>{{end}}<a class="back-link" href="/">返回资料架</a></section>{{template "page-footer" .}}{{template "page-script" .}}</main></body></html>{{end}}

{{define "directory"}}{{template "base-head" .}}{{template "topbar" .}}<main id="content"><nav class="crumbs" aria-label="路径导航"><a class="back-link" href="/">资料架</a><span class="crumb-separator" aria-hidden="true">/</span>{{range .Crumbs}}<a href="{{.URL}}">{{.Name}}</a><span class="crumb-separator" aria-hidden="true">/</span>{{end}}<span aria-current="page">{{.Name}}</span></nav><header class="directory-heading"><div><p class="eyebrow">目录浏览</p><h1>{{.Name}}</h1>{{if .Description}}<p class="description">{{.Description}}</p>{{end}}</div><span class="status {{if .Locked}}locked{{else if .Protected}}protected{{end}}">{{if .Locked}}⚠ 已锁定{{else if .Protected}}🔒 已保护{{else}}● 公开{{end}}</span></header>
<section class="directory-list" aria-label="目录内容"><ul>{{range .Items}}<li class="entry"><a class="entry-link" href="{{.URL}}" data-open-kind="{{.OpenKind}}"{{if eq .OpenMode "external"}} target="_blank" rel="noopener noreferrer"{{else if eq .OpenMode "modal"}} data-preview-kind="{{.PreviewKind}}" data-preview-url="{{.PreviewURL}}" data-preview-name="{{.Name}}" data-open-url="{{.OpenURL}}" data-download-url="{{.DownloadURL}}" data-can-zoom="{{.CanZoom}}" data-can-navigate-images="{{.CanNavigateImages}}" data-share-state="{{.Share.State}}" data-share-requires-password="{{.Share.RequiresPassword}}" data-share-expires-at="{{.Share.ExpiresAt}}" data-share-can-download="{{.Share.CanDownload}}"{{with .PreviousImage}} data-previous-image-name="{{.Name}}" data-previous-image-preview-url="{{.PreviewURL}}" data-previous-image-open-url="{{.OpenURL}}" data-previous-image-download-url="{{.DownloadURL}}" data-previous-image-can-zoom="{{.CanZoom}}"{{end}}{{with .NextImage}} data-next-image-name="{{.Name}}" data-next-image-preview-url="{{.PreviewURL}}" data-next-image-open-url="{{.OpenURL}}" data-next-image-download-url="{{.DownloadURL}}" data-next-image-can-zoom="{{.CanZoom}}"{{end}}{{else if eq .OpenMode "download"}} download{{end}}>{{.Name}}</a><span class="entry-type">{{.Kind}}</span><span class="entry-size">{{if .Size}}{{.Size}}{{else}}—{{end}}</span><time class="entry-modified">{{.Modified}}</time>{{if eq .OpenMode "modal"}}<button class="entry-action" type="button" data-open-kind="{{.OpenKind}}" data-preview-kind="{{.PreviewKind}}" data-preview-url="{{.PreviewURL}}" data-preview-name="{{.Name}}" data-open-url="{{.OpenURL}}" data-download-url="{{.DownloadURL}}" data-can-zoom="{{.CanZoom}}" data-can-navigate-images="{{.CanNavigateImages}}" data-share-state="{{.Share.State}}" data-share-requires-password="{{.Share.RequiresPassword}}" data-share-expires-at="{{.Share.ExpiresAt}}" data-share-can-download="{{.Share.CanDownload}}"{{with .PreviousImage}} data-previous-image-name="{{.Name}}" data-previous-image-preview-url="{{.PreviewURL}}" data-previous-image-open-url="{{.OpenURL}}" data-previous-image-download-url="{{.DownloadURL}}" data-previous-image-can-zoom="{{.CanZoom}}"{{end}}{{with .NextImage}} data-next-image-name="{{.Name}}" data-next-image-preview-url="{{.PreviewURL}}" data-next-image-open-url="{{.OpenURL}}" data-next-image-download-url="{{.DownloadURL}}" data-next-image-can-zoom="{{.CanZoom}}"{{end}}>{{if eq .OpenKind "html-render"}}预览源码{{else}}预览{{end}}</button>{{else if eq .OpenMode "external"}}<a class="entry-action" href="{{.URL}}" target="_blank" rel="noopener noreferrer">新标签打开</a>{{else if eq .OpenMode "download"}}<a class="entry-action" href="{{.URL}}" download>下载</a>{{end}}</li>{{else}}<li class="empty"><div class="empty-icon" aria-hidden="true">⌁</div><h2>此目录为空</h2><p class="empty-copy">没有可显示的文件或子目录。</p></li>{{end}}</ul></section>
<p class="preview-help">不可预览文件会由服务端按安全策略下载或在新标签打开；当前目录会保持不变。</p>{{template "preview-dialog" .}}{{template "page-footer" .}}{{template "page-script" .}}</main></body></html>{{end}}

{{define "error"}}{{template "base-head" .}}{{template "topbar" .}}<main id="content"><section class="panel" aria-labelledby="error-title"><p class="eyebrow">资料访问</p><h1 id="error-title">{{.Heading}}</h1><p class="description">{{.Detail}}</p><a class="back-link" href="{{.BackURL}}">返回上一层</a><a class="back-link" href="/">返回资料架</a></section>{{template "page-footer" .}}{{template "page-script" .}}</main></body></html>{{end}}

{{define "preview-dialog"}}<dialog class="preview-dialog" id="preview-dialog" role="dialog" aria-modal="true" aria-labelledby="preview-title"><section><header class="modal-head"><div><p class="eyebrow" id="preview-kind-label">文件预览</p><h2 id="preview-title" tabindex="-1"></h2></div><div class="modal-head-actions"><span class="status modal-share-status" id="preview-share-status" hidden></span><div class="modal-actions" id="preview-actions" hidden><a class="modal-control" id="preview-open" target="_blank" rel="noopener noreferrer">新窗口打开</a><a class="modal-control" id="preview-download" download>下载</a></div><button class="modal-control modal-close" id="preview-close" type="button" aria-label="关闭预览">×</button></div></header><div class="preview-area" id="preview-content" aria-live="polite"></div><footer class="modal-foot"><div class="modal-foot-left"><span class="preview-help" id="preview-help">按 Esc 关闭预览</span><div class="zoom-controls" id="zoom-controls" hidden aria-label="图片缩放"><button class="modal-control" id="zoom-out" type="button" aria-label="缩小图片">−</button><output class="zoom-value" id="zoom-value" aria-live="polite">100%</output><button class="modal-control" id="zoom-in" type="button" aria-label="放大图片">＋</button><button class="modal-control" id="zoom-fit" type="button">适应</button></div></div><div class="preview-nav" id="preview-nav" hidden><button class="modal-control" id="preview-previous" type="button">上一张</button><button class="modal-control" id="preview-next" type="button">下一张</button></div></footer></section></dialog>{{end}}

{{define "page-script"}}<script>(function(){
  var root=document.documentElement,accents=["azure","forest","terracotta"],themes=["light","dark","system"],accentKey="datashelf.accent.v1",themeKey="datashelf.theme.v1";
  document.querySelectorAll("[data-current-year]").forEach(function(year){year.textContent=String(new Date().getFullYear())});
  function stored(key){try{return localStorage.getItem(key)||""}catch(_){return ""}}
  function persist(key,value){try{localStorage.setItem(key,value)}catch(_){}}
  var appearanceToggle=document.getElementById("appearance-toggle"),appearanceMenu=document.getElementById("appearance-menu"),currentAccent=stored(accentKey),currentTheme=stored(themeKey);
  if(accents.indexOf(currentAccent)<0){currentAccent="azure"} if(themes.indexOf(currentTheme)<0){currentTheme="system"}
  function applyAppearance(){root.dataset.accent=currentAccent;if(currentTheme==="system"){delete root.dataset.theme}else{root.dataset.theme=currentTheme}document.querySelectorAll("[data-accent]").forEach(function(button){button.setAttribute("aria-checked",String(button.dataset.accent===currentAccent))});document.querySelectorAll("[data-theme]").forEach(function(button){button.setAttribute("aria-checked",String(button.dataset.theme===currentTheme))})}
  function closeAppearance(restore){if(!appearanceMenu){return}appearanceMenu.hidden=true;if(appearanceToggle){appearanceToggle.setAttribute("aria-expanded","false");if(restore){appearanceToggle.focus()}}}
  function openAppearance(){if(!appearanceMenu||!appearanceToggle){return}appearanceMenu.hidden=false;appearanceToggle.setAttribute("aria-expanded","true");var selected=appearanceMenu.querySelector('[role="menuitemradio"][aria-checked="true"]');(selected||appearanceMenu.querySelector('[role="menuitemradio"]')).focus()}
  applyAppearance();
  if(appearanceToggle&&appearanceMenu){appearanceToggle.addEventListener("click",function(){if(appearanceMenu.hidden){openAppearance()}else{closeAppearance(false)}});appearanceMenu.addEventListener("click",function(event){var button=event.target.closest("[role=menuitemradio]");if(!button){return}if(button.dataset.accent){currentAccent=button.dataset.accent;persist(accentKey,currentAccent)}if(button.dataset.theme){currentTheme=button.dataset.theme;persist(themeKey,currentTheme)}applyAppearance();closeAppearance(true)});appearanceMenu.addEventListener("keydown",function(event){var items=Array.prototype.slice.call(appearanceMenu.querySelectorAll('[role="menuitemradio"]')),index=items.indexOf(document.activeElement);if(event.key==="Escape"){event.preventDefault();closeAppearance(true)}else if(event.key==="ArrowDown"||event.key==="ArrowRight"){event.preventDefault();items[(index+1+items.length)%items.length].focus()}else if(event.key==="ArrowUp"||event.key==="ArrowLeft"){event.preventDefault();items[(index-1+items.length)%items.length].focus()}else if(event.key==="Home"){event.preventDefault();items[0].focus()}else if(event.key==="End"){event.preventDefault();items[items.length-1].focus()}else if(event.key==="Tab"){closeAppearance(false)}});document.addEventListener("pointerdown",function(event){if(!appearanceMenu.hidden&&!appearanceMenu.contains(event.target)&&!appearanceToggle.contains(event.target)){closeAppearance(false)}});document.addEventListener("keydown",function(event){if(event.key==="Escape"&&!appearanceMenu.hidden){closeAppearance(true)}})}
  var dialog=document.getElementById("preview-dialog");if(!dialog||!dialog.showModal){return}
  var content=document.getElementById("preview-content"),title=document.getElementById("preview-title"),kindLabel=document.getElementById("preview-kind-label"),help=document.getElementById("preview-help"),closeButton=document.getElementById("preview-close"),navigation=document.getElementById("preview-nav"),previous=document.getElementById("preview-previous"),next=document.getElementById("preview-next"),actions=document.getElementById("preview-actions"),openLink=document.getElementById("preview-open"),downloadLink=document.getElementById("preview-download"),shareStatus=document.getElementById("preview-share-status"),zoomControls=document.getElementById("zoom-controls"),zoomOut=document.getElementById("zoom-out"),zoomIn=document.getElementById("zoom-in"),zoomFit=document.getElementById("zoom-fit"),zoomValue=document.getElementById("zoom-value"),triggers=Array.prototype.slice.call(document.querySelectorAll("[data-preview-kind]")),capabilities={},activeTrigger,returnTrigger,abortController,imageState={zoom:1,x:0,y:0,pointerId:null,lastX:0,lastY:0,canvas:null,image:null};
  triggers.forEach(function(trigger){if(trigger.dataset.previewUrl&&!capabilities[trigger.dataset.previewUrl]){capabilities[trigger.dataset.previewUrl]=trigger}});
  function imageCapability(trigger,direction){var prefix=direction==="previous"?"previousImage":"nextImage",url=trigger.dataset[prefix+"PreviewUrl"];if(!url){return null}return capabilities[url]||null}
  function emptyContent(){if(abortController){abortController.abort();abortController=null}while(content.firstChild){content.removeChild(content.firstChild)}}
  function clear(){emptyContent();imageState={zoom:1,x:0,y:0,pointerId:null,lastX:0,lastY:0,canvas:null,image:null};zoomControls.hidden=true;navigation.hidden=true;actions.hidden=true;shareStatus.hidden=true;shareStatus.textContent=""}
  function textNode(message,className){var node=document.createElement(className?"pre":"p");if(className){node.className=className}node.textContent=message;content.appendChild(node)}
  function setZoom(value){if(!imageState.image){return}imageState.zoom=Math.max(.25,Math.min(4,value));if(imageState.zoom<=1){imageState.x=0;imageState.y=0}imageState.image.style.transform="translate("+imageState.x+"px,"+imageState.y+"px) scale("+imageState.zoom+")";imageState.canvas.classList.toggle("is-zoomed",imageState.zoom>1);zoomValue.value=Math.round(imageState.zoom*100)+"%";zoomValue.textContent=zoomValue.value;zoomOut.disabled=imageState.zoom<=.25;zoomIn.disabled=imageState.zoom>=4}
  function stepZoom(direction){setZoom(Math.round((imageState.zoom+direction*.25)*4)/4)}
  function fitImage(){if(!imageState.image||!imageState.image.naturalWidth){return}var canvas=imageState.canvas,scale=Math.min(canvas.clientWidth/imageState.image.naturalWidth,canvas.clientHeight/imageState.image.naturalHeight,1);setZoom(scale)}
  function updateActions(trigger){var openURL=trigger.dataset.openUrl,downloadURL=trigger.dataset.downloadUrl;openLink.hidden=!openURL;downloadLink.hidden=!downloadURL;openLink.textContent=trigger.dataset.openKind==="html-render"?"受控视图":"新窗口打开";if(openURL){openLink.href=openURL}else{openLink.removeAttribute("href")}if(downloadURL){downloadLink.href=downloadURL}else{downloadLink.removeAttribute("href")}actions.hidden=!openURL&&!downloadURL}
  function updateShareStatus(trigger){if(trigger.dataset.shareState!=="available"){return}var details=["已配置分享"];if(trigger.dataset.shareRequiresPassword==="true"){details.push("需密码验证")}if(trigger.dataset.shareExpiresAt){details.push("有效期至 "+trigger.dataset.shareExpiresAt)}if(trigger.dataset.shareCanDownload==="false"){details.push("下载受限")}shareStatus.textContent=details.join(" · ");shareStatus.hidden=false}
  function renderImage(url,name,canZoom,canNavigate){kindLabel.textContent="图片预览";help.textContent=canNavigate?"Esc 关闭；← / → 切换同目录图片":"Esc 关闭";var canvas=document.createElement("div"),image=document.createElement("img");canvas.className="image-canvas";image.className="preview-image";image.src=url;image.alt=name;canvas.appendChild(image);content.appendChild(canvas);imageState.canvas=canvas;imageState.image=image;zoomControls.hidden=!canZoom;image.addEventListener("load",function(){setZoom(1)});image.addEventListener("error",function(){emptyContent();zoomControls.hidden=true;textNode("图片无法加载。请在新窗口打开文件或下载。")});if(canZoom){canvas.addEventListener("wheel",function(event){if(!event.ctrlKey){return}event.preventDefault();stepZoom(event.deltaY<0?1:-1)},{passive:false});canvas.addEventListener("pointerdown",function(event){if(imageState.zoom<=1){return}imageState.pointerId=event.pointerId;imageState.lastX=event.clientX;imageState.lastY=event.clientY;canvas.setPointerCapture(event.pointerId);canvas.classList.add("is-panning")});canvas.addEventListener("pointermove",function(event){if(event.pointerId!==imageState.pointerId){return}imageState.x+=event.clientX-imageState.lastX;imageState.y+=event.clientY-imageState.lastY;imageState.lastX=event.clientX;imageState.lastY=event.clientY;setZoom(imageState.zoom)});function endPan(event){if(event.pointerId!==imageState.pointerId){return}imageState.pointerId=null;canvas.classList.remove("is-panning")}canvas.addEventListener("pointerup",endPan);canvas.addEventListener("pointercancel",endPan)}}
  function render(trigger){var kind=trigger.dataset.previewKind,url=trigger.dataset.previewUrl,name=trigger.dataset.previewName,canZoom=trigger.dataset.canZoom==="true",canNavigate=trigger.dataset.canNavigateImages==="true";activeTrigger=capabilities[url]||trigger;clear();title.textContent=name;updateActions(activeTrigger);updateShareStatus(activeTrigger);if(kind==="image"){var previousTarget=imageCapability(activeTrigger,"previous"),nextTarget=imageCapability(activeTrigger,"next");navigation.hidden=!canNavigate;previous.disabled=!previousTarget;next.disabled=!nextTarget;renderImage(url,name,canZoom,canNavigate);return}if(kind==="pdf"||kind==="markdown"){kindLabel.textContent=kind==="markdown"?"Markdown 文档":"PDF 预览";help.textContent=kind==="markdown"?"Esc 关闭；内容由服务端安全渲染":"Esc 关闭；文档可在此区域滚动阅读";var frame=document.createElement("iframe");frame.className="preview-document";frame.src=url;frame.title=name;frame.setAttribute("sandbox",kind==="markdown"?"allow-popups allow-popups-to-escape-sandbox":"");content.appendChild(frame);return}kindLabel.textContent=activeTrigger.dataset.openKind==="html-render"?"HTML 源码预览":"文本预览";help.textContent=activeTrigger.dataset.openKind==="html-render"?"Esc 关闭；源码仅以纯文本形式显示":"Esc 关闭；文本仅以纯文本形式显示";textNode("正在载入…","preview-text");abortController=new AbortController();fetch(url,{credentials:"same-origin",signal:abortController.signal}).then(function(response){if(!response.ok){throw new Error("HTTP "+response.status)}return response.text()}).then(function(value){emptyContent();textNode(value,"preview-text")}).catch(function(error){if(error.name!=="AbortError"){emptyContent();textNode("文本无法载入。请在新窗口打开文件或下载。","preview-text")}})}
  function open(trigger){returnTrigger=trigger;render(trigger);dialog.showModal();closeButton.focus()}
  function close(){if(dialog.open){dialog.close()}}
  triggers.forEach(function(trigger){trigger.addEventListener("click",function(event){event.preventDefault();open(trigger)})});closeButton.addEventListener("click",close);dialog.addEventListener("cancel",function(event){event.preventDefault();close()});dialog.addEventListener("click",function(event){if(event.target===dialog){close()}});dialog.addEventListener("close",function(){clear();if(returnTrigger&&document.contains(returnTrigger)){returnTrigger.focus()}});previous.addEventListener("click",function(){var target=imageCapability(activeTrigger,"previous");if(target){render(target);previous.focus()}});next.addEventListener("click",function(){var target=imageCapability(activeTrigger,"next");if(target){render(target);next.focus()}});zoomOut.addEventListener("click",function(){stepZoom(-1)});zoomIn.addEventListener("click",function(){stepZoom(1)});zoomFit.addEventListener("click",fitImage);
  dialog.addEventListener("keydown",function(event){var focusable=Array.prototype.slice.call(dialog.querySelectorAll("button:not([disabled]),a[href],iframe,[tabindex]:not([tabindex=\"-1\"]) ")).filter(function(element){return !element.hidden&&element.offsetParent!==null});if(event.key==="Escape"){event.preventDefault();close();return}if(event.key==="ArrowLeft"&&activeTrigger&&activeTrigger.dataset.previewKind==="image"&&!previous.disabled&&document.activeElement.tagName!=="INPUT"){previous.click();return}if(event.key==="ArrowRight"&&activeTrigger&&activeTrigger.dataset.previewKind==="image"&&!next.disabled&&document.activeElement.tagName!=="INPUT"){next.click();return}if(event.key==="Tab"&&focusable.length){var first=focusable[0],last=focusable[focusable.length-1];if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus()}else if(!event.shiftKey&&document.activeElement===last){event.preventDefault();first.focus()}}});
}());</script>{{end}}
