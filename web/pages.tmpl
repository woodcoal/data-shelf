{{define "base-head"}}<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light">
  <title>{{.PageTitle}}</title>
  <style>
    :root { color: #162234; background: #f4f7fb; font-family: Inter, "PingFang SC", "Microsoft YaHei", system-ui, sans-serif; line-height: 1.5; }
    * { box-sizing: border-box; }
    body { margin: 0; min-width: 320px; background: radial-gradient(circle at 15% -20%, #dceaff 0, transparent 32rem), #f4f7fb; }
    a { color: inherit; }
    a:focus-visible, button:focus-visible, input:focus-visible { outline: 3px solid #1f73df; outline-offset: 3px; }
    main { width: min(1120px, 100%); margin: 0 auto; padding: 40px 24px 64px; }
    .site-header { display: flex; align-items: start; justify-content: space-between; gap: 20px; margin-bottom: 28px; }
    h1 { margin: 0; font-size: clamp(1.75rem, 4vw, 2.5rem); line-height: 1.2; letter-spacing: -.035em; }
    h2 { margin: 0; font-size: 1.125rem; }
    p { margin: 0; }
    .eyebrow, .meta, .empty-copy { color: #64748b; }
    .eyebrow { margin-bottom: 6px; font-size: .875rem; font-weight: 650; letter-spacing: .03em; }
    .toolbar, .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
    .toolbar { margin: 0 0 20px; }
    .sort-link, .back-link { border: 1px solid #d9e1ec; border-radius: 999px; padding: 7px 12px; background: #fff; color: #46556a; text-decoration: none; font-size: .875rem; }
    .sort-link[aria-current="true"] { border-color: #1669c9; background: #eaf3ff; color: #0756ae; font-weight: 700; }
    .app-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 16px; }
    .card, .panel, .directory-list { background: rgba(255,255,255,.96); border: 1px solid #dce4ef; border-radius: 16px; box-shadow: 0 8px 24px rgba(24, 44, 74, .05); }
    .app-card { display: grid; gap: 14px; min-height: 190px; padding: 20px; color: inherit; text-decoration: none; transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease; }
    .app-card:hover { border-color: #8fbbe8; box-shadow: 0 14px 28px rgba(24, 80, 138, .12); transform: translateY(-2px); }
    .card-top, .app-footer, .directory-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .app-name, .entry-name { min-width: 0; overflow-wrap: anywhere; font-weight: 720; }
    .description { color: #4c5c71; overflow-wrap: anywhere; }
    .status { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 5px; border-radius: 999px; padding: 4px 8px; background: #eef4fb; color: #486078; font-size: .75rem; font-weight: 700; white-space: nowrap; }
    .status.locked { background: #fff1ed; color: #a33d22; }
    .status.protected { background: #fff8e6; color: #8b5d00; }
    .crumbs { margin-bottom: 18px; font-size: .9rem; color: #52657d; }
    .crumbs a { border-radius: 4px; }
    .crumb-separator { color: #94a3b8; }
    .directory-heading { margin: 0 0 18px; }
    .directory-list { overflow: hidden; }
    .directory-list ul { padding: 0; margin: 0; list-style: none; }
    .entry + .entry { border-top: 1px solid #e7edf4; }
    .entry a { display: grid; grid-template-columns: minmax(0, 1fr) 100px 104px 142px; gap: 16px; align-items: center; padding: 15px 20px; color: inherit; text-decoration: none; }
    .entry a:hover { background: #f5f9fe; }
    .entry-type, .entry-size, .entry-modified { color: #64748b; font-size: .875rem; }
    .entry-type { font-weight: 650; }
    .empty { padding: 40px 24px; text-align: center; }
    .empty-icon { display: grid; place-items: center; width: 44px; height: 44px; margin: 0 auto 12px; border-radius: 50%; background: #eaf3ff; color: #1968c3; font-size: 1.25rem; }
    .panel { width: min(460px, 100%); margin: clamp(24px, 8vh, 88px) auto 0; padding: clamp(24px, 5vw, 36px); }
    .panel > * + * { margin-top: 16px; }
    .notice { display: flex; gap: 10px; padding: 12px 14px; border: 1px solid #ffd2c8; border-radius: 10px; background: #fff5f2; color: #8b321f; }
    label { display: block; color: #334155; font-size: .925rem; font-weight: 700; }
    input, button { width: 100%; min-height: 46px; margin-top: 7px; border-radius: 9px; font: inherit; }
    input { border: 1px solid #b9c7d8; padding: 10px 12px; background: #fff; color: #162234; }
    button { border: 1px solid #0b5daf; padding: 10px 16px; background: #1268c4; color: #fff; font-weight: 720; cursor: pointer; }
    button:hover { background: #075aaf; }
    .form-help { color: #64748b; font-size: .875rem; }
    @media (max-width: 680px) { main { padding: 28px 16px 48px; } .site-header { display: block; } .site-header .toolbar { margin-top: 18px; } .entry a { grid-template-columns: minmax(0, 1fr) auto; gap: 6px 12px; padding: 14px 16px; } .entry-type, .entry-size, .entry-modified { font-size: .8rem; } .entry-type { grid-column: 1; } .entry-size, .entry-modified { grid-column: 2; text-align: right; } }
    @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; } }
  </style>
</head>
<body><main>{{end}}

{{define "home"}}{{template "base-head" .}}
<header class="site-header">
  <div><p class="eyebrow">本地只读资料架</p><h1>{{.Title}}</h1></div>
  <nav class="toolbar" aria-label="排序方式">
    <a class="sort-link" href="/?sort=modified" aria-current="{{if not .SortByName}}true{{else}}false{{end}}">最近修改</a>
    <a class="sort-link" href="/?sort=name" aria-current="{{if .SortByName}}true{{else}}false{{end}}">按名称</a>
  </nav>
</header>
<section class="app-grid" aria-label="应用列表">{{range .Apps}}
  <a class="card app-card" href="/a/{{pathEscape .Slug}}/">
    <span class="card-top"><span class="app-name">{{.Name}}</span><span class="status {{if .Locked}}locked{{else if .Protected}}protected{{end}}">{{if .Locked}}⚠ 管理员配置待修复{{else if .Protected}}🔒 需要密码{{else}}公开{{end}}</span></span>
    {{if .Description}}<p class="description">{{.Description}}</p>{{else}}<p class="description">暂无说明</p>{{end}}
    <span class="app-footer"><span class="meta">目录</span><time class="meta" datetime="{{.ModTime.Format "2006-01-02T15:04:05Z07:00"}}">{{.ModTime.Format "2006-01-02 15:04"}}</time></span>
  </a>{{else}}
  <div class="card empty"><div class="empty-icon" aria-hidden="true">⌁</div><h2>尚无可用应用</h2><p class="empty-copy">在数据目录中新建一个普通目录后，它会显示在这里。</p></div>
{{end}}</section>
</main></body></html>{{end}}

{{define "login"}}{{template "base-head" .}}
<section class="panel" aria-labelledby="login-title">
  <p class="eyebrow">受保护的资料</p><h1 id="login-title">{{.Name}}</h1><p class="description">请输入密码以继续访问。验证成功后会返回你刚才请求的页面。</p>
  {{if .Message}}<div class="notice" role="alert" aria-live="assertive"><span aria-hidden="true">!</span><span>{{.Message}}</span></div>{{end}}
  {{if not .Locked}}<form method="post" action="/_auth/{{pathEscape .Slug}}"><input type="hidden" name="return" value="{{.Return}}"><label for="password">密码</label><input id="password" name="password" type="password" autocomplete="current-password" required autofocus aria-describedby="password-help"><p class="form-help" id="password-help">按 Enter 键即可提交。</p><button type="submit">进入资料</button></form>{{else}}<a class="back-link" href="/">返回资料架</a>{{end}}
</section>
<script>document.addEventListener("DOMContentLoaded",function(){var input=document.getElementById("password");if(input){input.focus();}});</script>
</main></body></html>{{end}}

{{define "directory"}}{{template "base-head" .}}
<nav class="crumbs" aria-label="路径导航">{{range .Crumbs}}<a href="{{.URL}}">{{.Name}}</a><span class="crumb-separator" aria-hidden="true">/</span>{{end}}</nav>
<header class="directory-heading"><div><p class="eyebrow">目录浏览</p><h1>{{.Name}}</h1></div><span class="status {{if .Locked}}locked{{else if .Protected}}protected{{end}}">{{if .Locked}}⚠ 已锁定{{else if .Protected}}🔒 已保护{{else}}公开{{end}}</span></header>
<section class="directory-list" aria-label="目录内容"><ul>{{range .Items}}
  <li class="entry"><a href="{{.URL}}"><span class="entry-name">{{.Name}}</span><span class="entry-type">{{.Kind}}</span><span class="entry-size">{{if .Size}}{{.Size}}{{else}}—{{end}}</span><time class="entry-modified">{{.Modified}}</time></a></li>
{{else}}
  <li class="empty"><div class="empty-icon" aria-hidden="true">⌁</div><h2>此目录为空</h2><p class="empty-copy">没有可显示的文件或子目录。</p></li>
{{end}}</ul></section>
</main></body></html>{{end}}

{{define "error"}}{{template "base-head" .}}
<section class="panel" aria-labelledby="error-title"><p class="eyebrow">资料访问</p><h1 id="error-title">{{.Heading}}</h1><p class="description">{{.Detail}}</p><a class="back-link" href="{{.BackURL}}">返回上一层</a></section>
</main></body></html>{{end}}

{{/* Reserved integration state for a server-side preview handler. Unknown files
     continue to use Content-Disposition: attachment as required by the MVP. */}}
{{define "preview-unavailable"}}{{template "base-head" .}}<section class="panel" aria-labelledby="preview-title"><p class="eyebrow">文件预览</p><h1 id="preview-title">无法预览此文件</h1><p class="description">此格式不支持浏览器内预览。请下载后使用本地应用打开。</p><a class="back-link" href="{{.BackURL}}">返回目录</a></section></main></body></html>{{end}}
