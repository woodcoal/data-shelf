{{define "base-head"}}<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>{{.PageTitle}}</title>
  <link rel="stylesheet" href="{{assetURL "app.css"}}">
  <script>(function(){try{var accent=localStorage.getItem("datashelf.accent.v1"),theme=localStorage.getItem("datashelf.theme.v1");if(["azure","forest","terracotta"].indexOf(accent)>=0){document.documentElement.dataset.accent=accent}if(["light","dark"].indexOf(theme)>=0){document.documentElement.dataset.theme=theme}}catch(_){}}());</script>

</head>
<body><a class="skip-link" href="#content">跳到主要内容</a>{{end}}

{{define "appearance-controls"}}<section class="appearance" aria-label="显示偏好"><button class="appearance-toggle" id="appearance-toggle" type="button" aria-label="显示偏好" aria-haspopup="menu" aria-expanded="false" aria-controls="appearance-menu"><svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 15.5A8.5 8.5 0 0 1 8.5 4 8.5 8.5 0 1 0 20 15.5Z"/></svg></button><div class="appearance-menu" id="appearance-menu" role="menu" aria-label="主题与明暗偏好" hidden><span class="appearance-menu-label">色系</span><button type="button" role="menuitemradio" data-accent="azure" aria-checked="true">湛蓝</button><button type="button" role="menuitemradio" data-accent="forest" aria-checked="false">松绿</button><button type="button" role="menuitemradio" data-accent="terracotta" aria-checked="false">陶土</button><span class="appearance-menu-label">明暗偏好</span><button type="button" role="menuitemradio" data-theme="system" aria-checked="true">跟随系统</button><button type="button" role="menuitemradio" data-theme="light" aria-checked="false">浅色</button><button type="button" role="menuitemradio" data-theme="dark" aria-checked="false">深色</button></div></section>{{end}}

{{define "topbar"}}<header class="topbar"><div class="topbar-inner"><a class="brand" href="/"><span class="brand-mark" aria-hidden="true">▦</span><span>资料架</span></a>{{template "appearance-controls" .}}</div></header>{{end}}

{{define "page-footer"}}<footer class="page-footer"><span>© <span data-current-year></span> DataShelf</span><a href="https://github.com/woodcoal/data-shelf" target="_blank" rel="noopener noreferrer">DataShelf 项目</a></footer>{{end}}

{{define "home"}}{{template "base-head" .}}{{template "topbar" .}}<main id="content" tabindex="-1">
<header class="site-header"><div><p class="eyebrow">本地只读资料架</p><h1>{{.Title}}</h1>{{if .Description}}<p class="description">{{.Description}}</p>{{else}}<p class="description">浏览资料目录；需要密码的目录会在进入前进行验证。</p>{{end}}</div><nav class="toolbar" aria-label="排序方式"><a class="sort-link" href="/?sort=modified" aria-current="{{if not .SortByName}}true{{else}}false{{end}}">最近修改</a><a class="sort-link" href="/?sort=name" aria-current="{{if .SortByName}}true{{else}}false{{end}}">按名称</a></nav></header>
<section class="app-grid" aria-label="应用列表">{{range .Apps}}<a class="card app-card" href="{{.URL}}"><span class="card-top"><span class="app-name">{{.Name}}</span><span class="status {{if .Locked}}locked{{else if .Protected}}protected{{end}}">{{if .Locked}}⚠ 管理员配置待修复{{else if .Protected}}🔒 需要密码{{else}}● 公开{{end}}</span></span>{{if .Description}}<p class="description">{{.Description}}</p>{{else}}<p class="description">暂无说明</p>{{end}}<span class="app-footer"><span class="meta">目录</span><time class="meta" datetime="{{.ModTime.Format "2006-01-02T15:04:05Z07:00"}}">{{.ModTime.Format "2006-01-02 15:04"}}</time></span></a>{{else}}<div class="card empty"><div class="empty-icon" aria-hidden="true">⌁</div><h2>尚无可用应用</h2><p class="empty-copy">在数据目录中新建一个普通目录后，它会显示在这里。</p><div class="guide"><strong>首次管理员引导</strong><ol><li>确认 DataShelf 的数据根目录。</li><li>在其中创建一个资料目录，例如“设计资料”。</li><li>重新访问此页；需要保护时再在目录中放置私有配置。</li></ol></div></div>{{end}}</section>
{{template "page-footer" .}}{{template "page-script" .}}</main></body></html>{{end}}

{{define "login"}}{{template "base-head" .}}{{template "topbar" .}}<main id="content" tabindex="-1"><section class="panel" aria-labelledby="login-title"><p class="eyebrow">受保护的资料</p><h1 id="login-title">{{.Name}}</h1><p class="description">请输入密码以继续访问。验证成功后会返回你刚才请求的页面。</p>{{if .Message}}<div class="notice" role="alert" aria-live="assertive"><span aria-hidden="true">!</span><span>{{.Message}}</span></div>{{end}}<div class="login-actions">{{if not .Locked}}<form method="post" action="/_auth/{{pathEscape .Slug}}"><input type="hidden" name="return" value="{{.Return}}"><label for="password">密码</label><input id="password" name="password" type="password" autocomplete="current-password" required autofocus aria-describedby="password-help"><p class="form-help" id="password-help">按 Enter 键即可提交。</p><button type="submit">进入资料</button></form>{{end}}<a class="back-link login-back" href="/">返回资料架</a></div></section>{{template "page-footer" .}}{{template "page-script" .}}</main></body></html>{{end}}

{{define "directory"}}{{template "base-head" .}}{{template "topbar" .}}<main id="content" tabindex="-1"{{with .ShareCreateURL}} data-share-create-url="{{.}}"{{end}}><nav class="crumbs" aria-label="路径导航"><a class="back-link" href="/">资料架</a><span class="crumb-separator" aria-hidden="true">/</span>{{range .Crumbs}}<a href="{{.URL}}">{{.Name}}</a><span class="crumb-separator" aria-hidden="true">/</span>{{end}}<span aria-current="page">{{.Name}}</span></nav><header class="directory-heading"><div><p class="eyebrow">目录浏览</p><h1>{{.Name}}</h1>{{if .Description}}<p class="description">{{.Description}}</p>{{end}}</div><span class="status {{if .Locked}}locked{{else if .Protected}}protected{{end}}">{{if .Locked}}⚠ 已锁定{{else if .Protected}}🔒 已保护{{else}}● 公开{{end}}</span></header>
<section class="directory-list" aria-label="目录内容"><ul>{{range .Items}}<li class="entry"><a class="entry-link" href="{{.URL}}" data-open-kind="{{.OpenKind}}"{{if eq .OpenMode "external"}} target="_blank" rel="noopener noreferrer"{{else if and (eq .OpenMode "modal") (ne .OpenKind "html-render")}} data-preview-kind="{{.PreviewKind}}" data-preview-url="{{.PreviewURL}}" data-preview-name="{{.Name}}" data-open-url="{{.OpenURL}}" data-download-url="{{.DownloadURL}}" data-can-zoom="{{.CanZoom}}" data-can-navigate-images="{{.CanNavigateImages}}" data-share-state="{{.Share.State}}"{{with .Share.ShareURL}} data-share-url="{{.}}"{{end}} data-share-requires-password="{{.Share.RequiresPassword}}" data-share-expires-at="{{.Share.ExpiresAt}}" data-share-can-download="{{.Share.CanDownload}}"{{with .PreviousImage}} data-previous-image-name="{{.Name}}" data-previous-image-preview-url="{{.PreviewURL}}" data-previous-image-open-url="{{.OpenURL}}" data-previous-image-download-url="{{.DownloadURL}}" data-previous-image-can-zoom="{{.CanZoom}}"{{end}}{{with .NextImage}} data-next-image-name="{{.Name}}" data-next-image-preview-url="{{.PreviewURL}}" data-next-image-open-url="{{.OpenURL}}" data-next-image-download-url="{{.DownloadURL}}" data-next-image-can-zoom="{{.CanZoom}}"{{end}}{{else if eq .OpenMode "download"}} download{{end}}>{{.Name}}</a><span class="entry-type">{{.Kind}}</span><span class="entry-size">{{if .Size}}{{.Size}}{{else}}—{{end}}</span><time class="entry-modified">{{.Modified}}</time><span class="entry-actions">{{if eq .OpenMode "modal"}}<button class="entry-action" type="button" data-open-kind="{{.OpenKind}}" data-preview-kind="{{.PreviewKind}}" data-preview-url="{{.PreviewURL}}" data-preview-name="{{.Name}}" data-open-url="{{.OpenURL}}" data-download-url="{{.DownloadURL}}" data-can-zoom="{{.CanZoom}}" data-can-navigate-images="{{.CanNavigateImages}}" data-share-state="{{.Share.State}}"{{with .Share.ShareURL}} data-share-url="{{.}}"{{end}} data-share-requires-password="{{.Share.RequiresPassword}}" data-share-expires-at="{{.Share.ExpiresAt}}" data-share-can-download="{{.Share.CanDownload}}"{{with .PreviousImage}} data-previous-image-name="{{.Name}}" data-previous-image-preview-url="{{.PreviewURL}}" data-previous-image-open-url="{{.OpenURL}}" data-previous-image-download-url="{{.DownloadURL}}" data-previous-image-can-zoom="{{.CanZoom}}"{{end}}{{with .NextImage}} data-next-image-name="{{.Name}}" data-next-image-preview-url="{{.PreviewURL}}" data-next-image-open-url="{{.OpenURL}}" data-next-image-download-url="{{.DownloadURL}}" data-next-image-can-zoom="{{.CanZoom}}"{{end}}>{{if eq .OpenKind "html-render"}}预览源码{{else}}预览{{end}}</button>{{else if eq .OpenMode "external"}}<a class="entry-action" href="{{.URL}}" target="_blank" rel="noopener noreferrer">新标签打开</a>{{else if eq .OpenMode "download"}}<a class="entry-action" href="{{.URL}}" download>下载</a>{{end}}{{if $.ShareCreateURL}}<button class="entry-action" type="button" data-share-target-name="{{.Name}}" data-share-scope="{{.ShareScope}}">分享</button>{{end}}</span></li>{{else}}<li class="empty"><div class="empty-icon" aria-hidden="true">⌁</div><h2>此目录为空</h2><p class="empty-copy">没有可显示的文件或子目录。</p></li>{{end}}</ul></section>
{{if .ShareCreateURL}}<p class="share-management-entry"><button class="modal-control" type="button" data-share-target-name="." data-share-scope="directory" data-share-current-directory="true">分享当前目录</button><button class="modal-control" id="share-management-open" type="button">管理分享</button></p>{{end}}<p class="preview-help directory-preview-note">不可预览文件会由服务端按安全策略下载或在新标签打开；当前目录会保持不变。</p>{{template "preview-dialog" .}}{{template "share-dialog" .}}{{template "share-management-dialog" .}}{{template "page-footer" .}}{{template "page-script" .}}</main></body></html>{{end}}

{{define "error"}}{{template "base-head" .}}{{template "topbar" .}}<main id="content" tabindex="-1"><section class="panel" aria-labelledby="error-title"><p class="eyebrow">资料访问</p><h1 id="error-title">{{.Heading}}</h1><p class="description">{{.Detail}}</p><a class="back-link" href="{{.BackURL}}">返回上一层</a><a class="back-link" href="/">返回资料架</a></section>{{template "page-footer" .}}{{template "page-script" .}}</main></body></html>{{end}}

{{define "preview-dialog"}}<dialog class="preview-dialog" id="preview-dialog" role="dialog" aria-modal="true" aria-labelledby="preview-title"><section><header class="modal-head"><div><p class="eyebrow" id="preview-kind-label">文件预览</p><h2 id="preview-title" tabindex="-1"></h2></div><div class="modal-head-actions"><span class="status modal-share-status" id="preview-share-status" hidden></span><div class="modal-actions" id="preview-actions" hidden><a class="modal-control" id="preview-open" target="_blank" rel="noopener noreferrer">新窗口打开</a><a class="modal-control" id="preview-download" download>下载</a></div><div class="modal-actions" id="preview-share-actions" hidden><a class="modal-control" id="preview-share-open" target="_blank" rel="noopener noreferrer">打开分享</a><button class="modal-control" id="preview-share-copy" type="button">复制链接</button></div><button class="modal-control modal-close" id="preview-close" type="button" aria-label="关闭预览">×</button></div></header><div class="preview-area" id="preview-content" aria-live="polite"></div><p class="visually-hidden" id="preview-copy-status" role="status" aria-live="polite"></p><footer class="modal-foot" id="preview-foot" hidden><div class="modal-foot-left"><span class="preview-help" id="preview-help">按 Esc 关闭预览</span><div class="zoom-controls" id="zoom-controls" hidden aria-label="图片缩放"><button class="modal-control" id="zoom-out" type="button" aria-label="缩小图片">−</button><output class="zoom-value" id="zoom-value" aria-live="polite">100%</output><button class="modal-control" id="zoom-in" type="button" aria-label="放大图片">＋</button><button class="modal-control" id="zoom-fit" type="button">适应</button></div></div><div class="preview-nav" id="preview-nav" hidden><button class="modal-control" id="preview-previous" type="button">上一张</button><button class="modal-control" id="preview-next" type="button">下一张</button></div></footer></section></dialog>{{end}}

{{define "share-dialog"}}<dialog class="share-dialog" id="share-dialog" aria-modal="true" aria-labelledby="share-title"><section><header class="modal-head"><div><p class="eyebrow">受控分享</p><h2 id="share-title" tabindex="-1">创建分享</h2></div><button class="modal-control modal-close" id="share-close" type="button" aria-label="关闭分享设置">×</button></header><form id="share-form"><p class="share-target" id="share-target"></p><label for="share-password">访问密码<input id="share-password" name="password" type="password" autocomplete="new-password" required></label><label for="share-expires-at">有效期<input id="share-expires-at" name="expires_at" type="datetime-local" required></label><label class="share-download" for="share-allow-download"><input id="share-allow-download" name="allow_download" type="checkbox" checked>允许下载</label><p class="form-help">访问者只能使用链接访问所选范围。请确认下载权限和有效期，再创建。</p><p class="notice" id="share-error" role="alert" hidden></p><div class="share-result" id="share-result" hidden><label for="share-url">分享链接<input id="share-url" type="url" readonly></label><button class="modal-control" id="share-copy" type="button">复制链接</button></div><p class="visually-hidden" id="share-status" role="status" aria-live="polite"></p><div class="share-form-actions"><button class="modal-control" id="share-cancel" type="button">取消</button><button type="submit" id="share-submit">创建链接</button></div></form></section></dialog>{{end}}

{{define "share-management-dialog"}}<dialog class="share-dialog share-management-dialog" id="share-management-dialog" aria-modal="true" aria-labelledby="share-management-title"><section><header class="modal-head"><div><p class="eyebrow">受控分享</p><h2 id="share-management-title" tabindex="-1">管理分享</h2></div><button class="modal-control modal-close" id="share-management-close" type="button" aria-label="关闭分享管理">×</button></header><div class="share-management-body"><p class="form-help">只显示当前已授权目录及其文件和文件夹分享。</p><p class="notice" id="share-management-error" role="alert" hidden></p><p class="share-management-status" id="share-management-status" role="status" aria-live="polite">正在加载分享。</p><ul class="share-management-list" id="share-management-list" aria-label="分享列表"></ul></div></section></dialog>{{end}}

{{define "page-script"}}<script src="{{assetURL "app.js"}}" defer></script>{{end}}
